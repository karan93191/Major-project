<% layout("/layouts/boilerplate.ejs") %>
<div class="row">
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data" >
        <div class="col-8 offset-2">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required>
            <div class="valid-feedback">title look good</div>
        </div>
       <div>
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" placeholder="enter description" type="text" class="form-control" required></textarea>
         <div class="invalid-feedback">write description properly</div>
       </div>
       <div class="mb-3">
        <lable for="image" class="form-label">Upload image</label>
        <input name="listing[image]" placeholder="enter image url" type="file" class="form-control" required>
       </div>
      <div class="row">
        <div class="mb-3 col-4">
            <label for="price" class="form-label">price</label>
            <input name="listing[price]" placeholder="enter price"  class="form-control" required>
             <div class="invalid-feedback">enter the price</div>
        </div>
        <div class="mb-3 col-8">
            <label for="country" class="form-label">country</label>
            <input name="listing[country]" placeholder="enter country" type="text" class="form-control">
        </div>
      </div>

        
        <div class="mb-3">
            <label for="location" class="form-label">location</label>
        <input name="listing[location]" placeholder="enter location" type="text" class="form-control" required>
        </div>
        <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select class="form-select" id="category" name="listing[category]" required>
          <option value="">Select Category</option>
          <option value="Trending">Trending</option>
          <option value="Rooms">Rooms</option>
          <option value="Iconic cities">Iconic cities</option>
          <option value="Mountain">Mountain</option>
          <option value="Castle">Castle</option>
          <option value="Amazing pools">Amazing pools</option>
          <option value="Farms">Farms</option>
          <option value="Arctic">Arctic</option>
          <option value="Boats">Boats</option>
          <option value="Domes">Domes</option>
        </select>
      </div>
        <br><br>
        <button class="btn btn-dark add-btn">add</button>
        </div>
    </form>
    </div>
</body>
